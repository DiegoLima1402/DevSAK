<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DevSAK.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DevSAK">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Use ms-appx URI so WinUI loads the compiled resource from the package reliably -->
                <ResourceDictionary Source="ms-appx:///Themes/ThemeResources.xaml" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="ProgressBarTrackHeight">8</x:Double>
            <Style TargetType="ProgressBar">
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
