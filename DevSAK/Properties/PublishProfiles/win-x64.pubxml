<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\x64\Release\net8.0-windows10.0.19041.0\win-x64\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SatelliteResourceLanguages>pt-BR;en</SatelliteResourceLanguages>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <Target Name="RemoveUnusedLanguageFolders" AfterTargets="Publish">
    <PropertyGroup>
      <_PublishDirFull>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(PublishDir)').TrimEnd('\'))</_PublishDirFull>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Remove-UnusedLanguageFolders.ps1&quot; -PublishDir &quot;$(_PublishDirFull)&quot;" />
  </Target>
</Project>
