; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only.
;
; Packages the CONTENTS of the Release win-x64 publish output into {app}.
; The publish folder name itself is not created inside the installation directory.

#define MyAppName "DevSAK"
#define MyAppPublisher "ARCCA Softwares"
#define MyAppURL "https://arcca.com.br"
#define MyAppExeName "DevSAK.exe"
#define DoubleAmp(Value) StringChange(Value, "&", "&&")
#define EscapeConstArgument(Value) StringChange(StringChange(StringChange(Value, "%", "%25"), ",", "%2c"), "}", "%7d")

; Relative to this .iss file. Do not append "publish" under {app}.
#define BuildOutputDir AddBackslash(SourcePath) + "..\DevSAK\bin\x64\Release\net8.0-windows10.0.19041.0\win-x64\publish"
#define MyAppExePath AddBackslash(BuildOutputDir) + MyAppExeName
#define WebView2Bootstrapper AddBackslash(SourcePath) + "Redist\MicrosoftEdgeWebview2Setup.exe"

#if !FileExists(MyAppExePath)
  #error Publish the Release x64 / win-x64 output before compiling this installer.
#endif

#if !FileExists(WebView2Bootstrapper)
  #error Missing Installer\Redist\MicrosoftEdgeWebview2Setup.exe (WebView2 Evergreen Bootstrapper).
#endif

; FileVersion is 1.3.1.0; user-visible AppVersion is the semantic 1.3.1.
#define VerMajor
#define VerMinor
#define VerRev
#define VerBuild
#define MyAppFileVersion GetVersionComponents(MyAppExePath, VerMajor, VerMinor, VerRev, VerBuild)
#define MyAppVersion Str(VerMajor) + "." + Str(VerMinor) + "." + Str(VerRev)

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{B115A936-DE0A-48D3-8B42-E13296D49F1A}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={cm:NameAndVersion,{#EscapeConstArgument(MyAppName)},{#EscapeConstArgument(MyAppVersion)}}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={localappdata}\Programs\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
UninstallDisplayName={#MyAppName}
VersionInfoVersion={#MyAppFileVersion}
VersionInfoProductVersion={#MyAppVersion}
VersionInfoProductName={#MyAppName}
VersionInfoCompany={#MyAppPublisher}
UsePreviousAppDir=yes
UsePreviousLanguage=yes
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run on anything but x64 and Windows 11 on Arm.
ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the install be done in "64-bit mode" on x64 or Windows 11 on Arm.
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.17763
DisableProgramGroupPage=yes
LicenseFile=LICENSE.txt
InfoBeforeFile=INFO_BEFORE.txt
InfoAfterFile=INFO_AFTER.txt
PrivilegesRequired=lowest
CloseApplications=yes
CloseApplicationsFilter=*.exe,*.dll
RestartApplications=no
OutputDir=output
OutputBaseFilename=DevSAK_Installer_v{#MyAppVersion}
SetupIconFile=Assets\setup_icon.ico
Compression=lzma2
SolidCompression=yes
WizardStyle=modern dynamic windows11

[Languages]
Name: "brazilianportuguese"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[InstallDelete]
; On upgrade, remove previous application files from {app} so obsolete DLLs do not remain.
; User settings in {userappdata}\DevSAK and {localappdata}\DevSAK are not deleted.
Type: filesandordirs; Name: "{app}\*"

[Files]
; Copies every file and subdirectory from inside publish into {app}.
; The publish directory name is not included in the destination path.
Source: "{#BuildOutputDir}\*"; DestDir: "{app}"; Excludes: "*.pdb,*.appxrecipe,createdump.exe"; Flags: ignoreversion recursesubdirs createallsubdirs
; Evergreen Bootstrapper: installs WebView2 Runtime per-user when it is missing (WASDK dependency).
Source: "{#WebView2Bootstrapper}"; DestDir: "{tmp}"; Flags: deleteafterinstall; Check: not IsWebView2RuntimeInstalled
; NOTE: Don't use "Flags: ignoreversion" on any shared system files.

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
Filename: "{tmp}\MicrosoftEdgeWebview2Setup.exe"; Parameters: "/silent /install"; StatusMsg: "Instalando o Microsoft Edge WebView2 Runtime..."; Flags: waituntilterminated skipifdoesntexist; Check: not IsWebView2RuntimeInstalled
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#DoubleAmp(MyAppName)}}"; Flags: nowait postinstall skipifsilent

[Code]
function IsWebView2RuntimeInstalled: Boolean;
var
  Version: String;
begin
  Result := False;

  if RegQueryStringValue(HKLM, 'SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}', 'pv', Version)
     or RegQueryStringValue(HKLM, 'SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}', 'pv', Version)
     or RegQueryStringValue(HKCU, 'SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}', 'pv', Version) then
  begin
    Result := (Version <> '') and (Version <> '0.0.0.0');
    if Result then
      Exit;
  end;

  Result := DirExists(ExpandConstant('{localappdata}\Microsoft\EdgeWebView\Application'))
    or DirExists(ExpandConstant('{pf32}\Microsoft\EdgeWebView\Application'))
    or DirExists(ExpandConstant('{pf}\Microsoft\EdgeWebView\Application'));
end;
